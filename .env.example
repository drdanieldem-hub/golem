# Solana RPC (use a paid endpoint for mainnet; public RPCs rate-limit)
RPC_URL=https://api.mainnet-beta.solana.com
# GOLEM mint address, from the Hooked launch
GOLEM_MINT=
# Path to the treasury keypair (solana-keygen JSON). Holds the SOL used for buybacks.
TREASURY_KEYPAIR=./treasury.keypair.json
# Live trading only when this is exactly "false"
DRY_RUN=true
# Hours a param change waits before taking effect (hard floor: 6)
TIMELOCK_HOURS=24
# Jupiter swap API. Set JUP_API_KEY if you use the keyed endpoint.
JUP_API_BASE=https://lite-api.jup.ag/swap/v1
JUP_API_KEY=
# For `npm run mind`
ANTHROPIC_API_KEY=
MIND_MODEL=claude-opus-5-5
